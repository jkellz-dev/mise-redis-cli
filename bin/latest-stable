#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=./lib/utils.bash
. "${plugin_dir}/lib/utils.bash"

# redis-cli versions are published on download.redis.io (see list_all_versions),
# not on GitHub releases, so there is no "$GH_REPO/releases/latest" redirect to
# follow. Restrict to clean numeric versions (X.Y or X.Y.Z) so pre-release and
# legacy tags (e.g. 8.10-rc1, 8.2-m01, beta-9) are excluded. Note the shared
# sort_versions sorts those legacy tags above real releases, so filtering here
# (not just `tail`) is required to get the true latest stable.
list_all_versions |
	grep -E '^[0-9]+(\.[0-9]+){1,2}$' |
	sort_versions |
	tail -n1 |
	xargs echo
